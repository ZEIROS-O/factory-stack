{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://factory.local/schemas/ObjectiveEnvelopeV1.schema.json",
  "title": "ObjectiveEnvelopeV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "objectiveId", "issueIdentifier", "revision", "objectiveHash", "criteriaHash", "title", "originalRequest", "repository", "permissions", "limits", "verificationLevel", "expectedOutputs", "constraints", "acceptanceCriteria"],
  "properties": {
    "schemaVersion": { "const": "ObjectiveEnvelopeV1" },
    "objectiveId": { "type": "string", "minLength": 1 },
    "issueIdentifier": { "type": "string", "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$" },
    "revision": { "type": "integer", "minimum": 1 },
    "objectiveHash": { "$ref": "#/definitions/hash" },
    "criteriaHash": { "$ref": "#/definitions/hash" },
    "title": { "type": "string", "minLength": 1 },
    "originalRequest": { "type": "string", "minLength": 1 },
    "repository": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "baseCommit", "branch"],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "baseCommit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "branch": { "type": "string", "pattern": "^paperclip/" }
      }
    },
    "permissions": {
      "type": "object", "additionalProperties": false,
      "required": ["filesystem", "network", "externalEffects"],
      "properties": {
        "filesystem": {
          "type": "object", "additionalProperties": false,
          "required": ["read", "write"],
          "properties": {
            "read": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "write": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
          }
        },
        "network": { "enum": ["none", "provider_only"] },
        "externalEffects": { "type": "array", "maxItems": 0 }
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["wallClockMinutes", "costCeilingUsd", "outerFactoryCostCeilingUsd", "maxReviewRounds"],
      "properties": {
        "wallClockMinutes": { "type": "integer", "minimum": 1 },
        "costCeilingUsd": { "type": "number", "exclusiveMinimum": 0 },
        "outerFactoryCostCeilingUsd": { "type": "number", "exclusiveMinimum": 0 },
        "maxReviewRounds": { "type": "integer", "minimum": 1 }
      }
    },
    "verificationLevel": { "enum": ["routine", "important", "critical"] },
    "expectedOutputs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "constraints": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "acceptanceCriteria": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "requirement", "command"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]+-[0-9]+-AC-[0-9]{2}$" },
          "requirement": { "type": "string", "minLength": 1 },
          "command": { "$ref": "#/definitions/command" }
        }
      }
    }
  },
  "definitions": {
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "command": {
      "type": "object", "additionalProperties": false,
      "required": ["argv", "cwd"],
      "properties": {
        "argv": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "cwd": { "const": "." }
      }
    }
  }
}
