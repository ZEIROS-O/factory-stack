{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://factory.local/schemas/AssessmentV1.schema.json",
  "title": "AssessmentV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "assessmentId", "objective", "executionRunId", "executionReceiptHash", "reviewer", "repository", "deterministicResults", "criteria", "overallVerdict", "assessedAt"],
  "properties": {
    "schemaVersion": { "const": "AssessmentV1" },
    "assessmentId": { "type": "string", "minLength": 1 },
    "objective": { "$ref": "#/definitions/objectiveRef" },
    "executionRunId": { "type": "string", "minLength": 1 },
    "executionReceiptHash": { "$ref": "#/definitions/hash" },
    "reviewer": {
      "type": "object", "additionalProperties": false,
      "required": ["agentName", "modelFamily"],
      "properties": { "agentName": { "type": "string", "minLength": 1 }, "modelFamily": { "type": "string", "minLength": 1 } }
    },
    "repository": {
      "type": "object", "additionalProperties": false,
      "required": ["baseCommit", "headCommit", "diffHash", "changedPaths"],
      "properties": {
        "baseCommit": { "$ref": "#/definitions/commit" },
        "headCommit": { "$ref": "#/definitions/commit" },
        "diffHash": { "$ref": "#/definitions/hash" },
        "changedPaths": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "deterministicResults": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["criterionId", "argv", "exitCode", "passed", "outputHash"],
        "properties": {
          "criterionId": { "type": "string", "minLength": 1 },
          "argv": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "exitCode": { "type": "integer" },
          "passed": { "type": "boolean" },
          "outputHash": { "$ref": "#/definitions/hash" }
        }
      }
    },
    "criteria": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["criterionId", "verdict", "evidenceRefs", "reasoning", "uncertainty"],
        "properties": {
          "criterionId": { "type": "string", "minLength": 1 },
          "verdict": { "enum": ["PASS", "FAIL", "BLOCKED", "UNCERTAIN"] },
          "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "reasoning": { "type": "string", "minLength": 1 },
          "uncertainty": { "type": ["string", "null"] }
        }
      }
    },
    "overallVerdict": { "enum": ["PASS", "FAIL", "BLOCKED", "UNCERTAIN"] },
    "assessedAt": { "type": "string", "format": "date-time" }
  },
  "definitions": {
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "objectiveRef": {
      "type": "object", "additionalProperties": false,
      "required": ["objectiveId", "revision", "objectiveHash", "criteriaHash"],
      "properties": {
        "objectiveId": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "objectiveHash": { "$ref": "#/definitions/hash" },
        "criteriaHash": { "$ref": "#/definitions/hash" }
      }
    }
  }
}
